# GigaTIFF Server environment configuration.
# Copy to /etc/gigatiff/gigatiff-server.env or use it as a Compose env_file.

GIGATIFF_ROOT=/data
GIGATIFF_ADDR=0.0.0.0:8080
GIGATIFF_TILE_SIZE=512
GIGATIFF_MAX_OUTPUT_PIXELS=16777216
GIGATIFF_MAX_CHUNK_MB=256
GIGATIFF_QUALITY=85
GIGATIFF_BACKEND=auto
GIGATIFF_JP2_BACKEND=auto

GIGATIFF_CACHE_DIR=/cache
GIGATIFF_CACHE_BACKEND=dragonfly
GIGATIFF_DRAGONFLY_URL=redis://dragonfly:6379/
GIGATIFF_CACHE_NAMESPACE=gigatiff-server-response-v10
GIGATIFF_CACHE_MAX_MB=4096
GIGATIFF_CACHE_PRUNE_INTERVAL_SEC=60
GIGATIFF_CACHE_TTL_SEC=604800

GIGATIFF_MAX_CONCURRENT_RENDERS=4
GIGATIFF_MAX_CONCURRENT_RENDERS_PER_IP=2
GIGATIFF_MAX_CONCURRENT_RENDERS_PER_FILE=2
GIGATIFF_RENDER_TIMEOUT_SEC=120
GIGATIFF_MAX_UPSCALE=4.0
GIGATIFF_RATE_LIMIT_PER_MINUTE=600
GIGATIFF_ENFORCE_READ_ONLY_ROOT=true
